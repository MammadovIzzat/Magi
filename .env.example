# Copy to .env and set a strong admin password.
# The Magi server refuses to start while the password is still the default.
MAGI_PASS=change-me-to-a-long-passphrase

# Optional — extra certificate names/IPs clients use to reach the server (its LAN IP or
# DNS name). Comma-separated, IP:x / DNS:x. Clients pin the fingerprint regardless.
# MAGI_SERVER_SAN=DNS:magi.corp.local,IP:10.0.0.9
