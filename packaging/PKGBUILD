# Maintainer: MammadovIzzat <izzatmmmdv@gmail.com>
pkgname=magi
pkgver=0.7.2
pkgrel=1
pkgdesc="The pentester's familiar — engagement checklists, target tracker and evidence log"
arch=('any')
url="https://github.com/MammadovIzzat/Magi"
license=('MIT')
# electron runs the desktop window; node runs the CLI and the optional 'magi serve'.
# The database layer is better-sqlite3-multiple-ciphers (SQLCipher) — a native module. Its
# prebuilt binary (N-API, so it works under both Node and Electron) ships with the package;
# python is only needed so `npm install` can fall back to compiling if a prebuild is missing.
# Pinned to the electron series this was tested against — the launcher will use any
# electron39+ it finds, so change this line if you prefer a different one.
# openssl: 'magi server' shells out to it once to create its durable certificate.
depends=('nodejs>=22.5.0' 'electron43' 'openssl')
makedepends=('npm' 'python' 'gcc' 'make')
options=('!debug' '!strip')

_srcdir="$(realpath "${startdir}/..")"

build() {
  cd "$_srcdir"
  npm install --no-audit --no-fund --silent      # esbuild + the native SQLCipher driver
  node build/build.mjs
}

# The one runtime dependency that isn't inlined into the bundle: the native SQLCipher driver.
# Ship only its runtime subset (JS + the prebuilt binaries), not the C sources or dev headers.
_install_driver() {
  local dst="$1" mod=node_modules/better-sqlite3-multiple-ciphers
  for f in $(cd "$mod" && find lib -type f); do install -Dm644 "$mod/$f" "$dst/$mod/$f"; done
  install -Dm644 "$mod/package.json" "$dst/$mod/package.json"
  # Linux prebuilds for both arches (the loader picks by platform+arch at runtime).
  for a in linux-x64 linux-arm64; do
    [ -f "$mod/prebuilds/$a.node" ] && install -Dm644 "$mod/prebuilds/$a.node" "$dst/$mod/prebuilds/$a.node"
  done
}

check() {
  cd "$_srcdir"
  # A database from before the sync columns existed must still migrate on first boot.
  # (That upgrade path shipped broken once — it belongs in the package's own gate.)
  node scripts/migrate-smoke.mjs
  node scripts/stash-smoke.mjs
  # Paint the real UI in a headless browser: a render-time ReferenceError passes
  # every syntax check and still produces a blank window.
  node scripts/smoke.mjs
  local tmp; tmp="$(mktemp -d)"
  cp dist/magi.cjs "$tmp/"
  # the bundle inlines everything except the native SQLCipher driver, which it require()s at
  # runtime — make it resolvable from the boot dir, mirroring what the package ships.
  _install_driver "$tmp"
  # the bundle must boot with only that one native module on disk (no public/, no other deps)
  ( cd "$tmp"
    MAGI_PORT=45998 MAGI_DB="$tmp/check.db" timeout 6 node magi.cjs >out.log 2>&1 || true
    grep -q "MAGI" out.log || { echo "bundle failed to start:"; cat out.log; exit 1; } )
  # team-server mode must boot over HTTPS and mint its durable certificate
  ( cd "$tmp"
    MAGI_SERVER=1 MAGI_HOST=127.0.0.1 MAGI_PORT=45996 MAGI_DB="$tmp/srv.db" MAGI_DATA_DIR="$tmp/srvdir" \
      MAGI_PASS=checkpassword123 timeout 6 node magi.cjs >srv.log 2>&1 || true
    { grep -q "MAGI SERVER" srv.log && [ -f "$tmp/srvdir/server/server.crt" ]; } \
      || { echo "server-mode bundle failed:"; cat srv.log; exit 1; } )
  # and the embeddable one must export the Express app without listening
  MAGI_EMBED=1 MAGI_DB="$tmp/check2.db" node -e '
    const m = require("'"$_srcdir"'/dist/magi-server.cjs");
    const app = m.default ?? m;
    if (typeof app !== "function") { console.error("embed bundle does not export the app"); process.exit(1); }
  '
  rm -rf "$tmp"
}

package() {
  cd "$_srcdir"

  # desktop app: electron main + the embeddable server + the UI on disk
  install -Dm644 electron/main.js       "$pkgdir/usr/lib/magi/electron/main.js"
  install -Dm644 electron/dispatch.js   "$pkgdir/usr/lib/magi/electron/dispatch.js"
  install -Dm644 electron/unlock.html   "$pkgdir/usr/lib/magi/electron/unlock.html"
  install -Dm644 dist/magi-server.cjs   "$pkgdir/usr/lib/magi/magi-server.cjs"
  install -Dm644 packaging/app-package.json "$pkgdir/usr/lib/magi/package.json"
  for f in $(cd public && find . -type f); do
    install -Dm644 "public/$f" "$pkgdir/usr/lib/magi/public/${f#./}"
  done

  # server + CLI bundles
  install -Dm644 dist/magi.cjs     "$pkgdir/usr/lib/magi/magi.cjs"
  install -Dm644 dist/magi-cli.cjs "$pkgdir/usr/lib/magi/magi-cli.cjs"

  # the native SQLCipher driver the bundles require() at runtime
  _install_driver "$pkgdir/usr/lib/magi"

  sed "s/@VERSION@/$pkgver/" packaging/magi.sh > "$srcdir/magi.launcher"
  install -Dm755 "$srcdir/magi.launcher" "$pkgdir/usr/bin/magi"

  install -Dm644 packaging/magi.desktop "$pkgdir/usr/share/applications/magi.desktop"
  install -Dm644 packaging/magi.svg     "$pkgdir/usr/share/icons/hicolor/scalable/apps/magi.svg"
  install -Dm644 packaging/magi.png     "$pkgdir/usr/share/icons/hicolor/256x256/apps/magi.png"
  install -Dm644 README.md              "$pkgdir/usr/share/doc/$pkgname/README.md"
}
