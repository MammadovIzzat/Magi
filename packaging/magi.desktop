[Desktop Entry]
Type=Application
Name=Magi
GenericName=Pentest checklist
Comment=Engagement checklists, target tracker and evidence log
Exec=magi
Icon=magi
Terminal=false
Categories=Development;Security;
Keywords=pentest;security;checklist;engagement;audit;
# Electron sets WM_CLASS from the app name; this makes the taskbar group the
# window under Magi's own icon.
StartupWMClass=magi
StartupNotify=true
